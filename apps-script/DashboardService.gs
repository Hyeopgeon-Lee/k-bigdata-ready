function latestMap(name,key){const out={};rows(name).sort((a,b)=>String(a.checked_at||'').localeCompare(String(b.checked_at||''))).forEach(x=>out[String(x[key])]=x);return out}
function getMyDashboard(s){const p=getMyProfile(s),gm=latestMap('GITHUB_CHECK','student_id'),bm=latestMap('BLOG_CHECK','student_id'),g=gm[String(s.student_id)]||{},suggest=[];if(p.student.cover_letter_status==='미작성'||p.student.cover_letter_status==='작성중')suggest.push('자기소개서 준비 상태를 확인해 보세요.');if(Number(g.active_repository_count||0)>Number(g.readme_count||0))suggest.push('대표 Repository의 README를 보완해 보세요.');if(Number(g.inactive_days||0)>=14)suggest.push('최근 GitHub 활동이 뜸합니다. 진행 중인 작업을 정리해 보세요.');if(!p.student.notion_url)suggest.push('Notion 포트폴리오가 아직 등록되지 않았습니다.');return{student:p.student,github:safeRow(g),blog:safeRow(bm[String(s.student_id)]||{}),suggestions:suggest}}
function publicStudents(){const students=active('STUDENTS'),gm=latestMap('GITHUB_CHECK','student_id'),bm=latestMap('BLOG_CHECK','student_id'),repos=active('REPOSITORIES'),certs=active('CERTIFICATES');return students.map(s=>({student_id:s.student_id,name:s.name,career_target:s.career_target,last_activity_at:(gm[String(s.student_id)]||{}).last_activity_at||'',github_active_7d:Number((gm[String(s.student_id)]||{}).commits_7d||0)>0,repository_count:repos.filter(r=>String(r.student_id)===String(s.student_id)).length,blog_last_activity:(bm[String(s.student_id)]||{}).last_repo_commit_at||'',notion_registered:Boolean(s.notion_url),resume_status:s.resume_status,cover_letter_status:s.cover_letter_status,certificate_count:certs.filter(c=>String(c.student_id)===String(s.student_id)&&c.status==='취득').length}))}
function getClassDashboard(){const ss=publicStudents();return{summary:{'전체 학생':ss.length,'최근 7일 GitHub 활동':ss.filter(x=>x.github_active_7d).length,'Notion 등록':ss.filter(x=>x.notion_registered).length,'이력서 최종완성':ss.filter(x=>x.resume_status==='최종 완성').length,'자기소개서 완성':ss.filter(x=>['기본본 완성','기업 지원 가능'].includes(x.cover_letter_status)).length,'자격증 보유':ss.filter(x=>x.certificate_count>0).length},students:ss}}
function getAdminDashboard(){const students=active('STUDENTS'),gm=latestMap('GITHUB_CHECK','student_id'),publics=publicStudents(),items=students.map(s=>{const g=gm[String(s.student_id)]||{},reasons=[];if(Number(g.inactive_days)>=14)reasons.push('14일 이상 미활동');if(!Number(g.active_repository_count))reasons.push('Repository 미등록');if(!s.notion_url)reasons.push('Notion 미등록');if(g.check_status==='FAILED')reasons.push('자동점검 실패');return{student_id:s.student_id,name:s.name,career_target:s.career_target,reasons:reasons}});const logs=rows('CHECK_LOG').filter(x=>String(x.started_at).startsWith(today()));return{summary:{'전체 학생 수':students.length,'최근 7일 GitHub 활동':publics.filter(x=>x.github_active_7d).length,'14일 이상 미활동':items.filter(x=>x.reasons.includes('14일 이상 미활동')).length,'Notion 미등록':items.filter(x=>x.reasons.includes('Notion 미등록')).length,'GitHub Pages 미등록':students.filter(x=>!x.github_pages_url).length,'이력서 미완성':students.filter(x=>x.resume_status!=='최종 완성').length,'자기소개서 미완성':students.filter(x=>!['기본본 완성','기업 지원 가능'].includes(x.cover_letter_status)).length,'자격증 보유':publics.filter(x=>x.certificate_count>0).length,'오늘 점검 성공/실패':logs.reduce((a,x)=>a+Number(x.success_count||0),0)+' / '+logs.reduce((a,x)=>a+Number(x.failed_count||0),0)},students:items}}
function getAdminStudentDetail(_,sid){const s=active('STUDENTS').find(x=>String(x.student_id)===String(sid));if(!s)throw publicError('NOT_FOUND','학생 정보를 찾을 수 없습니다.');const repos=active('REPOSITORIES').filter(x=>String(x.student_id)===String(sid)),rm=latestMap('REPOSITORY_CHECK','repo_id'),memo=rows('PROFESSOR_MEMO').find(x=>String(x.student_id)===String(sid));return{student:safeRow(s),repositories:repos.map(r=>Object.assign(safeRow(r),safeRow(rm[r.repo_id]||{}))),certificates:active('CERTIFICATES').filter(x=>String(x.student_id)===String(sid)).map(safeRow),history:getChangeHistory(sid),checks:{github:(latestMap('GITHUB_CHECK','student_id')[String(sid)]||{}),blog:(latestMap('BLOG_CHECK','student_id')[String(sid)]||{})},memo:memo?safeRow(memo):null}}
function saveProfessorMemo(_,req){const existing=rows('PROFESSOR_MEMO').find(x=>String(x.student_id)===String(req.student_id)),t=now(),o={memo_id:existing?existing.memo_id:id('memo'),student_id:req.student_id,memo_text:String(req.memo_text||''),created_at:existing?existing.created_at:t,updated_at:t};upsert('PROFESSOR_MEMO','student_id',o);history(req.student_id,'교수 메모','memo','', '[비공개 메모 수정]','ADMIN');return{saved:true}}
