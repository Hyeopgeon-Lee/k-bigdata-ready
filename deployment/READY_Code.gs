function notionPageId(url){
  const match=String(url||'').match(/([0-9a-fA-F]{32})(?:[?#]|$)/);
  return match?match[1].replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/,'$1-$2-$3-$4-$5'):'';
}

