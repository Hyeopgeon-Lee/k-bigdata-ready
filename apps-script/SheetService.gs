function db(){const sid=props().getProperty('SPREADSHEET_ID');if(!sid)throw publicError('CONFIG_ERROR','Spreadsheet 설정이 필요합니다.');return SpreadsheetApp.openById(sid)}
function initializeSpreadsheet(){const ss=db();Object.keys(READY.SHEETS).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const headers=READY.SHEETS[name];if(sh.getLastRow()===0)sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight('bold').setBackground('#e8eef8');else{const existing=sh.getRange(1,1,1,Math.max(headers.length,sh.getLastColumn())).getValues()[0];headers.forEach((h,i)=>{if(existing[i]!==h)sh.getRange(1,i+1).setValue(h)})}sh.setFrozenRows(1)});return{spreadsheetId:ss.getId(),sheets:Object.keys(READY.SHEETS)}}
function rows(name){const sh=db().getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0];return sh.getRange(2,1,sh.getLastRow()-1,h.length).getValues().map((v,i)=>Object.assign({_row:i+2},Object.fromEntries(h.map((x,j)=>[x,v[j]]))))}
function append(name,obj){const sh=db().getSheetByName(name),h=READY.SHEETS[name];sh.appendRow(h.map(k=>obj[k]===undefined?'':obj[k]));return obj}
function upsert(name,key,obj){const all=rows(name),hit=all.find(r=>String(r[key])===String(obj[key])),sh=db().getSheetByName(name),h=READY.SHEETS[name];if(hit){const merged=Object.assign({},hit,obj);sh.getRange(hit._row,1,1,h.length).setValues([h.map(k=>merged[k]===undefined?'':merged[k])]);return merged}return append(name,obj)}
function updateRow(name,row,obj){const sh=db().getSheetByName(name),h=READY.SHEETS[name],merged=Object.assign({},row,obj);sh.getRange(row._row,1,1,h.length).setValues([h.map(k=>merged[k]===undefined?'':merged[k])]);return merged}
function active(name){return rows(name).filter(r=>String(r.active).toLowerCase()!=='false'&&r.active!==0)}
function safeRow(r){const o=Object.assign({},r);delete o._row;delete o.pin_hash;return o}
