function doGet(e){return respond_({success:true,data:{service:'READY API',status:'ok',time:now()}})}
function doPost(e){try{const req=JSON.parse((e.postData&&e.postData.contents)||'{}');if(!req.action)throw publicError('ACTION_REQUIRED','요청 작업이 없습니다.');const actions={health:()=>({status:'ok',time:now()}),getPublicSummary:()=>getPublicSummary(),registerStudent:()=>registerStudent(req),studentLogin:()=>studentLogin(req),studentLogout:()=>logout(req.token),getMyDashboard:()=>getMyDashboard(requireSession(req.token,'STUDENT')),getClassDashboard:()=>getClassDashboard(requireSession(req.token,'STUDENT')),getMyProfile:()=>getMyProfile(requireSession(req.token,'STUDENT')),updateMyProfile:()=>updateMyProfile(requireSession(req.token,'STUDENT'),req.profile),addRepository:()=>addRepository(requireSession(req.token,'STUDENT'),req.repository),updateRepository:()=>updateRepository(requireSession(req.token,'STUDENT'),req),removeRepository:()=>removeRepository(requireSession(req.token,'STUDENT'),req.repo_id),addCertificate:()=>addCertificate(requireSession(req.token,'STUDENT'),req.certificate),updateCertificate:()=>updateCertificate(requireSession(req.token,'STUDENT'),req),removeCertificate:()=>removeCertificate(requireSession(req.token,'STUDENT'),req.certificate_id),getChangeHistory:()=>getChangeHistory(requireSession(req.token,'STUDENT').student_id),runMyGitHubCheck:()=>runMyCheck(requireSession(req.token,'STUDENT')),adminLogin:()=>adminLogin(req),adminLogout:()=>logout(req.token),getAdminDashboard:()=>getAdminDashboard(requireSession(req.token,'ADMIN')),getAdminStudentDetail:()=>getAdminStudentDetail(requireSession(req.token,'ADMIN'),req.student_id),saveProfessorMemo:()=>saveProfessorMemo(requireSession(req.token,'ADMIN'),req),runBatchCheck:()=>runBatchCheck(requireSession(req.token,'ADMIN')),sendWeeklyReport:()=>sendWeeklyReport(requireSession(req.token,'ADMIN'))};if(!actions[req.action])throw publicError('UNKNOWN_ACTION','지원하지 않는 요청입니다.');return respond_({success:true,data:actions[req.action]()})}catch(err){console.error(err.stack||err);return respond_({success:false,error:{code:err.code||'INTERNAL_ERROR',message:err.code?err.message:'요청을 처리하지 못했습니다. 잠시 후 다시 시도해 주세요.'}})}}
function respond_(body){return ContentService.createTextOutput(JSON.stringify(body)).setMimeType(ContentService.MimeType.JSON)}
function validateConfiguration(){const required=['SPREADSHEET_ID','GITHUB_TOKEN','ADMIN_PIN_HASH','PIN_SALT','REPORT_EMAIL','APP_URL'];const missing=required.filter(k=>!props().getProperty(k));return{valid:!missing.length,missing:missing,timezone:Session.getScriptTimeZone(),warnings:Session.getScriptTimeZone()===READY.TZ?[]:['프로젝트 시간대를 Asia/Seoul로 설정하세요.']}}
