  if(second&&!resumeOK)add('resume','이력서 미완성',3);if(second&&!coverOK)add('cover','자기소개서 미완성',4);
  const gates=[githubOK,repositoryOK,readmeOK,portfolioRegistered,portfolioOK].concat(second?[resumeOK,coverOK]:[]),met=gates.filter(Boolean).length,all=gates.every(Boolean),status=all?'준비 우수':met>=Math.ceil(gates.length*.7)?'준비 양호':met>0?'준비 중':'관심 필요';issues.sort((a,b)=>a.priority-b.priority);
