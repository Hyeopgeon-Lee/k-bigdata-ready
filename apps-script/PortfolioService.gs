function checkPublicPortfolio(student){const url=student.portfolio_url||student.blog_url||student.github_pages_url||'',result={student_id:student.student_id,checked_at:now(),url:url,site_available:false,check_status:'SUCCESS',error_message:''};if(!url)return result;try{const response=UrlFetchApp.fetch(url,{muteHttpExceptions:true,followRedirects:true,headers:{'User-Agent':'READY-portfolio-monitor'}});result.site_available=response.getResponseCode()>=200&&response.getResponseCode()<400;if(!result.site_available){result.check_status='FAILED';result.error_message='HTTP '+response.getResponseCode()}}catch(e){result.check_status='FAILED';result.error_message=String(e.message||e).slice(0,250)}return result}
function updatePublicPortfolioCheck(student){const result=checkPublicPortfolio(student);upsert('PORTFOLIO_CHECK','student_id',result);return result}
