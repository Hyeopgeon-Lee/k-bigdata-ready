function reportHtml(cur,prev){const keys=[['전체 학생','total_students'],['준비 우수','excellent'],['준비 양호','good'],['준비 중','preparing'],['관심 필요','attention_count'],['7일 활동일 충족','github_active_7d'],['14일 이상 미활동','github_inactive_14d'],['README 미작성','readme_missing'],['README 보완 필요','readme_needs_work'],['포트폴리오 미등록','portfolio_missing'],['2학년 이력서 미완성','grade2_resume_incomplete'],['2학년 자기소개서 미완성','grade2_cover_incomplete']],rowsHtml=keys.map(([label,key])=>'<tr><td style="padding:8px;border-bottom:1px solid #e5e9ef">'+escMail(label)+'</td><td style="padding:8px;border-bottom:1px solid #e5e9ef;text-align:right;font-weight:bold">'+escMail(cur[key])+'명</td><td style="padding:8px;border-bottom:1px solid #e5e9ef;text-align:right;color:#637083">'+(prev&&prev[key]!==undefined?escMail(Number(cur[key])-Number(prev[key])>=0?'+':'')+escMail(Number(cur[key])-Number(prev[key])):'-')+'</td></tr>').join(''),attention=cur.attention.map(s=>'<tr><td style="padding:9px;border-bottom:1px solid #eee">'+escMail(s.name)+' · '+escMail(s.grade)+'학년</td><td style="padding:9px;border-bottom:1px solid #eee">'+escMail(s.preparation_status)+'</td><td style="padding:9px;border-bottom:1px solid #eee">'+s.priority_issues.slice(0,3).map(escMail).join('<br>')+'</td></tr>').join('')||'<tr><td colspan="3" style="padding:12px">우선 확인할 학생이 없습니다.</td></tr>';return '<div style="font-family:Arial,sans-serif;color:#172033;max-width:760px;margin:auto"><div style="background:#174ea6;color:white;padding:24px"><h1 style="margin:0">READY</h1><p>빅데이터소프트웨어공학과 학생 취업준비 주간 점검</p></div><h2>준비 현황</h2><table style="width:100%;border-collapse:collapse"><tr><th align="left">항목</th><th align="right">이번 주</th><th align="right">전주 대비</th></tr>'+rowsHtml+'</table><h2>이번 주 우선 확인 학생</h2><table style="width:100%;border-collapse:collapse"><tr><th align="left">학생</th><th align="left">상태</th><th align="left">우선 보완사항</th></tr>'+attention+'</table><p style="text-align:center"><a href="'+escMail(props().getProperty('APP_URL'))+'" style="display:inline-block;background:#174ea6;color:#fff;text-decoration:none;padding:12px 20px;border-radius:7px">READY 학생 현황 바로가기</a></p></div>'}
function sendWeeklyReport(){const cur=snapshot(),all=rows('WEEKLY_SNAPSHOT').filter(x=>x.snapshot_date!==cur.snapshot_date).sort((a,b)=>String(b.snapshot_date).localeCompare(String(a.snapshot_date))),prev=all[0]||null;upsert('WEEKLY_SNAPSHOT','snapshot_date',cur);const d=new Date(),week=Math.ceil(d.getDate()/7),subject='[READY] '+Utilities.formatDate(d,READY.TZ,'yyyy년 M월')+' '+week+'주차 학생 취업준비 점검 리포트';try{MailApp.sendEmail({to:props().getProperty('REPORT_EMAIL'),subject:subject,htmlBody:reportHtml(cur,prev),body:'READY 주간 리포트입니다. '+props().getProperty('APP_URL')});append('CHECK_LOG',{log_id:id('log'),batch_id:'WEEKLY_EMAIL',started_at:now(),finished_at:now(),target_count:1,success_count:1,failed_count:0,status:'SUCCESS',error_message:''});return{sent:true,to:props().getProperty('REPORT_EMAIL'),subject:subject}}catch(e){append('CHECK_LOG',{log_id:id('log'),batch_id:'WEEKLY_EMAIL',started_at:now(),finished_at:now(),target_count:1,success_count:0,failed_count:1,status:'FAILED',error_message:e.message});throw e}}
function sendTestWeeklyReport(){const result=sendWeeklyReport();result.test=true;return result}

