function gh(path,optional){const token=props().getProperty('GITHUB_TOKEN');if(!token)throw publicError('CONFIG_ERROR','GitHub 연동 설정이 필요합니다.');const r=UrlFetchApp.fetch('https://api.github.com'+path,{headers:{Authorization:'Bearer '+token,Accept:'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28','User-Agent':'READY-portfolio-monitor'},muteHttpExceptions:true});const code=r.getResponseCode();if(code===404&&optional)return null;if(code<200||code>=300){const e=publicError('GITHUB_ERROR',code===404?'등록한 GitHub 정보를 확인할 수 없습니다.':'GitHub 정보를 확인하지 못했습니다.');e.technical='GitHub HTTP '+code+' '+r.getContentText().slice(0,300);throw e}return JSON.parse(r.getContentText())}
function isoDaysAgo(n){return new Date(Date.now()-n*86400000).toISOString()}
function commitCount(owner,repo,since,author){const q='/repos/'+encodeURIComponent(owner)+'/'+encodeURIComponent(repo)+'/commits?since='+encodeURIComponent(since)+(author?'&author='+encodeURIComponent(author):'')+'&per_page=100';return (gh(q,true)||[]).length}
function checkRepository(student,repo){const base='/repos/'+encodeURIComponent(repo.repo_owner)+'/'+encodeURIComponent(repo.repo_name),meta=gh(base),commits=gh(base+'/commits?per_page=1',true)||[],last=commits[0]&&commits[0].commit&&commits[0].commit.author.date||meta.pushed_at||'',o={repo_id:repo.repo_id,student_id:student.student_id,checked_at:now(),last_commit_at:last,commits_7d:commitCount(repo.repo_owner,repo.repo_name,isoDaysAgo(7)),commits_30d:commitCount(repo.repo_owner,repo.repo_name,isoDaysAgo(30)),student_commits_7d:commitCount(repo.repo_owner,repo.repo_name,isoDaysAgo(7),student.github_username),student_commits_30d:commitCount(repo.repo_owner,repo.repo_name,isoDaysAgo(30),student.github_username),readme_exists:Boolean(gh(base+'/readme',true)),primary_language:meta.language||'',github_updated_at:meta.updated_at||'',check_status:'SUCCESS',error_message:''};upsert('REPOSITORY_CHECK','repo_id',o);return o}
function detectBlog(student){if(!student.github_pages_url&&!student.github_pages_repo)return{student_id:student.student_id,checked_at:now(),site_available:false,platform_type:'미등록',check_status:'SUCCESS',error_message:''};let available=false;try{if(student.github_pages_url){const r=UrlFetchApp.fetch(student.github_pages_url,{muteHttpExceptions:true,followRedirects:true});available=r.getResponseCode()>=200&&r.getResponseCode()<400}}catch(e){}let last='',platform='URL';const p=githubParts(student.github_pages_repo);if(p&&p.repo){const meta=gh('/repos/'+p.owner+'/'+p.repo,true);if(meta){last=meta.pushed_at||'';for(const candidate of [{path:'_posts',type:'Jekyll'},{path:'content',type:'Hugo'},{path:'posts',type:'Posts'},{path:'blog',type:'Blog'}]){if(gh('/repos/'+p.owner+'/'+p.repo+'/contents/'+candidate.path,true)){platform=candidate.type;break}}}}return{student_id:student.student_id,checked_at:now(),site_available:available,last_repo_commit_at:last,last_post_date:'',posts_30d:'',platform_type:platform,check_status:'SUCCESS',error_message:''}}
function checkStudent(student){const repos=active('REPOSITORIES').filter(r=>String(r.student_id)===String(student.student_id)),results=[];let error='';repos.forEach(r=>{try{results.push(checkRepository(student,r))}catch(e){error+=(error?' | ':'')+(e.technical||e.message);upsert('REPOSITORY_CHECK','repo_id',{repo_id:r.repo_id,student_id:student.student_id,checked_at:now(),check_status:'FAILED',error_message:e.technical||e.message})}});const dates=results.map(x=>x.last_commit_at).filter(Boolean).sort().reverse(),last=dates[0]||'',inactive=last?Math.floor((Date.now()-new Date(last).getTime())/86400000):'',status=!student.github_username||!repos.length?'미등록':inactive===''?'점검 필요':inactive<READY.ACTIVE_DAYS?'정상':inactive<READY.WARN_DAYS?'관심':'점검 필요',g={student_id:student.student_id,checked_at:now(),last_activity_at:last,commits_7d:results.reduce((n,x)=>n+x.student_commits_7d,0),commits_30d:results.reduce((n,x)=>n+x.student_commits_30d,0),active_repository_count:repos.length,readme_count:results.filter(x=>x.readme_exists).length,inactive_days:inactive,activity_status:status,check_status:error?'FAILED':'SUCCESS',error_message:error};upsert('GITHUB_CHECK','student_id',g);try{upsert('BLOG_CHECK','student_id',detectBlog(student))}catch(e){upsert('BLOG_CHECK','student_id',{student_id:student.student_id,checked_at:now(),check_status:'FAILED',error_message:e.technical||e.message})}if(error)throw publicError('CHECK_FAILED','일부 GitHub 정보를 확인하지 못했습니다.');return g}
