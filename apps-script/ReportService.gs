function snapshot(){const d=getAdminDashboard(),p=publicStudents(),gm=latestMap('GITHUB_CHECK','student_id'),bm=latestMap('BLOG_CHECK','student_id'),logs=rows('CHECK_LOG').filter(x=>String(x.started_at).slice(0,10)>=Utilities.formatDate(new Date(Date.now()-7*86400000),READY.TZ,'yyyy-MM-dd'));return{snapshot_date:today(),total_students:p.length,github_active_7d:p.filter(x=>x.github_active_7d).length,github_inactive_14d:Object.values(gm).filter(x=>Number(x.inactive_days)>=14).length,blog_active_7d:Object.values(bm).filter(x=>x.last_repo_commit_at&&Date.now()-new Date(x.last_repo_commit_at)<7*86400000).length,notion_registered:p.filter(x=>x.notion_registered).length,resume_completed:p.filter(x=>x.resume_status==='최종 완성').length,cover_letter_completed:p.filter(x=>['기본본 완성','기업 지원 가능'].includes(x.cover_letter_status)).length,certificate_holders:p.filter(x=>x.certificate_count>0).length,check_success:logs.reduce((n,x)=>n+Number(x.success_count||0),0),check_failed:logs.reduce((n,x)=>n+Number(x.failed_count||0),0),attention:d.students.filter(x=>x.reasons.length).slice(0,20)}}
function escMail(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function reportHtml(cur,prev){const keys=[['전체 학생','total_students'],['최근 7일 GitHub 활동','github_active_7d'],['14일 이상 미활동','github_inactive_14d'],['Notion 등록','notion_registered'],['이력서 최종완성','resume_completed'],['자기소개서 완성','cover_letter_completed']],cards=keys.map(([l,k])=>'<td style="padding:8px"><div style="border:1px solid #dce2ea;border-radius:8px;padding:14px"><div style="color:#637083">'+l+'</div><strong style="font-size:24px">'+cur[k]+'</strong></div></td>').join(''),changes=keys.slice(1).map(([l,k])=>'<tr><td style="padding:8px;border-bottom:1px solid #eee">'+l+'</td><td style="padding:8px;border-bottom:1px solid #eee">'+(prev?prev[k]:'-')+' → '+cur[k]+' '+(prev?'('+(cur[k]-prev[k]>=0?'+':'')+(cur[k]-prev[k])+')':'')+'</td></tr>').join(''),attention=cur.attention.map(s=>'<tr><td style="padding:8px;border-bottom:1px solid #eee">'+escMail(s.name)+'</td><td style="padding:8px;border-bottom:1px solid #eee">'+escMail(s.career_target)+'</td><td style="padding:8px;border-bottom:1px solid #eee;color:#b42318">'+escMail(s.reasons.join(', '))+'</td></tr>').join('')||'<tr><td colspan="3" style="padding:12px">점검 필요 학생이 없습니다.</td></tr>';return '<div style="font-family:Arial,sans-serif;color:#172033;max-width:760px;margin:auto"><div style="background:#174ea6;color:white;padding:24px"><h1 style="margin:0">READY</h1><p>빅데이터소프트웨어공학과<br>학생 포트폴리오 주간 점검 리포트</p></div><h2>전체 현황</h2><table role="presentation" style="width:100%"><tr>'+cards+'</tr></table><h2>지난주 대비 변화</h2><table style="width:100%;border-collapse:collapse">'+changes+'</table><h2>이번 주 점검 필요 학생</h2><table style="width:100%;border-collapse:collapse"><tr><th align="left">학생</th><th align="left">희망직무</th><th align="left">점검사항</th></tr>'+attention+'</table><h2>미완성 항목</h2><p>Notion 미등록 '+(cur.total_students-cur.notion_registered)+'명 · 이력서 미완성 '+(cur.total_students-cur.resume_completed)+'명 · 자기소개서 미완성 '+(cur.total_students-cur.cover_letter_completed)+'명</p><p style="text-align:center"><a href="'+escMail(props().getProperty('APP_URL'))+'" style="display:inline-block;background:#174ea6;color:#fff;text-decoration:none;padding:12px 20px;border-radius:7px">READY 학생 현황 바로가기</a></p><p style="color:#637083;font-size:12px">이 메일은 READY 취업 포트폴리오 관리 시스템에서 자동 생성한 주간 점검 리포트입니다.</p></div>'}
function sendWeeklyReport(){const cur=snapshot(),all=rows('WEEKLY_SNAPSHOT').filter(x=>x.snapshot_date!==cur.snapshot_date).sort((a,b)=>String(b.snapshot_date).localeCompare(String(a.snapshot_date))),prev=all[0]||null;upsert('WEEKLY_SNAPSHOT','snapshot_date',cur);const d=new Date(),week=Math.ceil(d.getDate()/7),subject='[READY] '+Utilities.formatDate(d,READY.TZ,'yyyy년 M월')+' '+week+'주차 학생 포트폴리오 주간 점검 리포트';try{MailApp.sendEmail({to:props().getProperty('REPORT_EMAIL'),subject:subject,htmlBody:reportHtml(cur,prev),body:'READY 주간 리포트입니다. '+props().getProperty('APP_URL')});append('CHECK_LOG',{log_id:id('log'),batch_id:'WEEKLY_EMAIL',started_at:now(),finished_at:now(),target_count:1,success_count:1,failed_count:0,status:'SUCCESS',error_message:''});return{sent:true,to:props().getProperty('REPORT_EMAIL'),subject:subject}}catch(e){append('CHECK_LOG',{log_id:id('log'),batch_id:'WEEKLY_EMAIL',started_at:now(),finished_at:now(),target_count:1,success_count:0,failed_count:1,status:'FAILED',error_message:e.message});throw e}}
function sendTestWeeklyReport(){const result=sendWeeklyReport();result.test=true;return result}
