function setupTriggers(){const names=['scheduledBatchCheck','sendWeeklyReport'];ScriptApp.getProjectTriggers().filter(t=>names.includes(t.getHandlerFunction())).forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('scheduledBatchCheck').timeBased().atHour(6).everyDays(1).inTimezone(READY.TZ).create();ScriptApp.newTrigger('scheduledBatchCheck').timeBased().atHour(7).everyDays(1).inTimezone(READY.TZ).create();ScriptApp.newTrigger('sendWeeklyReport').timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(8).everyWeeks(1).inTimezone(READY.TZ).create();return ScriptApp.getProjectTriggers().filter(t=>names.includes(t.getHandlerFunction())).map(t=>({handler:t.getHandlerFunction(),eventType:String(t.getEventType()),id:t.getUniqueId()}))}

